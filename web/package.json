{
  "name": "@stoked/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:flow": "tsx ../packages/chain/scripts/with-validator.ts tsx e2e-flow/run.ts",
    "test:e2e": "pnpm test:ui && pnpm test:flow",
    "test:validator": "tsx ../packages/chain/scripts/with-validator.ts vitest run -c vitest.validator.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "@stoked/chain": "workspace:*",
    "@stoked/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.2",
    "bs58": "^6.0.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  }
}
