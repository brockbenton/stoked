# Copy to .env. Devnet only. Never commit real values.
SOLANA_RPC_URL=https://api.devnet.solana.com
# JSON byte array of the devnet treasury keypair (server only)
TREASURY_SECRET_KEY=
# Printed by the mint setup script
MINT_TNVDA=
MINT_TAAPL=
MINT_TSPY=
MINT_TTSLA=
MINT_TCOST=
# Supabase (server only: no NEXT_PUBLIC_ prefix)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public origin used in gift links, no trailing slash
APP_ORIGIN=http://localhost:3000
# Local development only: 1 = in-memory database instead of Supabase. Refused
# unless SOLANA_RPC_URL is a local validator, and never on Vercel.
STOKED_LOCAL_DB=
# Only with STOKED_LOCAL_DB: status checks before a claim answers "pending".
STOKED_CONFIRM_POLLS=
# Escrow (docs/escrow.md), off by default. ESCROW_PROGRAM_ID is the deployed
# program: keep it set while any escrow gift exists. STOKED_ESCROW=1 makes new
# gifts lock their tokens on chain. Apply the escrow migration first.
ESCROW_PROGRAM_ID=
STOKED_ESCROW=
# Wallet payments, off by default. A token mint here makes senders pay for gifts
# from Phantom with it; needs ESCROW_PROGRAM_ID. Circle's devnet USDC is
# 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU. The symbol defaults to USDC.
STOKED_PAYMENT_MINT=
STOKED_PAYMENT_SYMBOL=
# UI tests only (set by playwright.config.ts): fixture data instead of the API.
# NEXT_PUBLIC_STOKED_CLIENT=fixture
# Devnet smoke test only (see docs/devnet.md): the deployment to test, the
# treasury's public address, and a short-lived token for protected previews.
# SMOKE_BASE_URL=
# SMOKE_TREASURY_ADDRESS=
# Deployments with wallet payments: a throwaway devnet keypair that pays.
# SMOKE_SENDER_SECRET=
# VERCEL_OIDC_TOKEN=
