# Copy to .env. Devnet only. Never commit real values.
SOLANA_RPC_URL=https://api.devnet.solana.com
# JSON byte array of the devnet treasury keypair (server only)
TREASURY_SECRET_KEY=
# Printed by the mint setup script
MINT_TNVDA=
MINT_TAAPL=
MINT_TSPY=
MINT_TTSLA=
MINT_TCOST=
# Supabase (server only: no NEXT_PUBLIC_ prefix)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public origin used in gift links, no trailing slash
APP_ORIGIN=http://localhost:3000
